# Copy this file to .env and fill in real values on the server (90.93).
# DO NOT commit the real .env to git.

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=marketing
DB_USER=postgres
DB_PASSWORD=**.

# --- API server ---
API_HOST=0.0.0.0
API_PORT=3001

# Comma separated list, e.g. http://192.168.90.23,https://your-domain.com
# "*" is fine for initial testing, tighten it once IIS/ARR is set up.
CORS_ORIGINS=*

DEBUG=false
